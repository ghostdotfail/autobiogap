{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "scripts/**/*",
    "package.json",
  ],
  "exclude": ["node_modules", "dist", "scripts/equivalence.ts", "scripts/preview-equivalence.ts"]
}
